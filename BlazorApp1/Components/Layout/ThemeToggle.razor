@inject IJSRuntime JS
@implements IAsyncDisposable

<button type="button"
        class="btn btn-link text-decoration-none p-2"
        title="@GetTooltipText()"
        aria-label="Toggle theme"
        disabled="@(_isToggling || _theme == null)"
        style="@(_theme == null ? "opacity: 0;" : "")"
        @onclick="Toggle">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="theme-icon" viewBox="0 0 16 16">
        @if (_theme == THEME_DARK)
        {
            <!-- Sun icon -->
            <path d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm0 1a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0zm0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13zm8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5zM3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8zm10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0zm-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0zm9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707zM4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708z"/>
        }
        else if (_theme == THEME_LIGHT)
        {
            <!-- Moon icon -->
            <path d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278z"/>
        }
    </svg>
</button>

@code {
    private const string THEME_DARK = "dark";
    private const string THEME_LIGHT = "light";
    
    private IJSObjectReference? _themeModule;
    private string? _theme;
    private bool _isToggling;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _themeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/bs-theme.mjs");
            _theme = await _themeModule.InvokeAsync<string>("get");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to initialize theme module: {ex.Message}");
        }
    }

    private async Task Toggle()
    {
        if (_themeModule is null || _isToggling) return;

        try
        {
            _isToggling = true;
            _theme = await _themeModule.InvokeAsync<string>("toggle");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to toggle theme: {ex.Message}");
        }
        finally
        {
            _isToggling = false;
        }
    }

    private string GetTooltipText() => _theme switch
    {
        THEME_DARK => "Switch to light mode",
        THEME_LIGHT => "Switch to dark mode",
        _ => "Toggle theme"
    };

    public async ValueTask DisposeAsync()
    {
        if (_themeModule is not null)
        {
            try { await _themeModule.DisposeAsync(); } 
            catch { /* Ignore disposal errors */ }
        }
    }
}

